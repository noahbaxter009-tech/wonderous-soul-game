# Procedural SFX - generated at runtime, so no sound files are required.
# These are original game-style effects made from simple tones/noise.
# -----------------------------------------------------------------------------
def _make_sfx(duration, start_hz, end_hz, volume=0.45, noise=0.0, attack=0.004, release=0.08):
    if not pygame.mixer.get_init():
        return None
    rate = 22050
    count = max(1, int(rate * duration))
    frames = bytearray()
    phase = 0.0
    for i in range(count):
        t = i / rate
        q = i / max(1, count - 1)
        hz = start_hz + (end_hz - start_hz) * q
        phase += 2.0 * math.pi * hz / rate
        tone = math.sin(phase)
        # A second harmonic gives attacks a slightly metallic character.
        tone += 0.22 * math.sin(phase * 2.03)
        n = (random.random() * 2.0 - 1.0) * noise
        env_a = min(1.0, t / max(attack, 0.0001))
        env_r = min(1.0, (duration - t) / max(release, 0.0001))
        env = max(0.0, min(1.0, env_a, env_r))
        sample = int(max(-1.0, min(1.0, (tone + n) * volume * env)) * 32767)
        frames += struct.pack('<h', sample)
    buf = io.BytesIO()
    with wave.open(buf, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(frames)
    buf.seek(0)
    try:
        return pygame.mixer.Sound(file=buf)
    except Exception:
        return None


def _make_slash_sfx(duration=0.16, volume=0.52, heavy=False):
    """Create a short, swooshing blade-slash sound in memory.

    It uses a fast downward frequency sweep plus shaped noise, rather than
    a simple beep, to give the attack a sharper air-cutting character.
    """
    if not pygame.mixer.get_init():
        return None
    rate = 22050
    count = max(1, int(rate * duration))
    frames = bytearray()
    phase = 0.0
    last_noise = 0.0
    for i in range(count):
        t = i / rate
        q = i / max(1, count - 1)

        # Very fast pitch sweep: high at the beginning, dropping as the
        # blade travels through the air. Heavy attacks start lower and last longer.
        start = 1700.0 if heavy else 2300.0
        end = 180.0 if heavy else 260.0
        hz = start * ((end / start) ** q)
        phase += 2.0 * math.pi * hz / rate

        # Filtered noise gives the sound its airy "whoosh" instead of a beep.
        raw = random.random() * 2.0 - 1.0
        last_noise = last_noise * 0.72 + raw * 0.28
        noise_layer = (raw - last_noise * 0.45)

        # Add a quieter metallic harmonic at the start of the swing.
        tone = math.sin(phase) * 0.32 + math.sin(phase * 1.97) * 0.10

        # Quick attack, strongest around the middle, then a smooth fade.
        envelope = math.sin(math.pi * (q ** 0.72)) ** 0.72
        if heavy:
            envelope *= 1.10
        sample = (tone + noise_layer * (1.15 if not heavy else 1.30)) * volume * envelope
        sample = int(max(-1.0, min(1.0, sample)) * 32767)
        frames += struct.pack('<h', sample)

    buf = io.BytesIO()
    with wave.open(buf, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(frames)
    buf.seek(0)
    try:
        return pygame.mixer.Sound(file=buf)
    except Exception:
        return None


def _make_footstep_sfx(duration=0.075, volume=0.34):
    """Create a tiny soft footstep: low thump + dusty noise, entirely in memory."""
    if not pygame.mixer.get_init():
        return None
    rate = 22050
    count = max(1, int(rate * duration))
    frames = bytearray()
    phase = 0.0
    filtered = 0.0
    for i in range(count):
        t = i / rate
        q = i / max(1, count - 1)
        hz = 105.0 - 48.0 * q
        phase += 2.0 * math.pi * hz / rate
        raw = random.random() * 2.0 - 1.0
        filtered = filtered * 0.78 + raw * 0.22
        thump = math.sin(phase) * 0.72
        dust = filtered * 0.42
        env = (1.0 - q) ** 2.1
        sample = int(max(-1.0, min(1.0, (thump + dust) * volume * env)) * 32767)
        frames += struct.pack('<h', sample)
    buf = io.BytesIO()
    with wave.open(buf, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(frames)
    buf.seek(0)
    try:
        return pygame.mixer.Sound(file=buf)
    except Exception:
        return None


def _make_jump_sfx(duration=0.16, volume=0.42):
    """Create a light airy jump/launch sound in memory."""
    if not pygame.mixer.get_init():
        return None
    rate = 22050
    count = max(1, int(rate * duration))
    frames = bytearray()
    phase1 = phase2 = 0.0
    for i in range(count):
        q = i / max(1, count - 1)
        # Rising pitch gives a small upward "fwoop" rather than a beep.
        hz1 = 240.0 + 760.0 * q
        hz2 = 520.0 + 900.0 * q
        phase1 += 2.0 * math.pi * hz1 / rate
        phase2 += 2.0 * math.pi * hz2 / rate
        raw = random.random() * 2.0 - 1.0
        env = math.sin(math.pi * (q ** 0.55)) ** 0.8
        sample = (math.sin(phase1) * 0.55 + math.sin(phase2) * 0.16 + raw * 0.10) * volume * env
        frames += struct.pack('<h', int(max(-1.0, min(1.0, sample)) * 32767))
    buf = io.BytesIO()
    with wave.open(buf, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(frames)
    buf.seek(0)
    try:
        return pygame.mixer.Sound(file=buf)
    except Exception:
        return None


