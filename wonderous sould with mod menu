                pygame.draw.polygon(scr, (205, 80, 92), [(b + 1, cy * T + T), (b + 5, cy * T + 6), (b + 6, cy * T + T)])
        for bx, by in s.room["benches"]:
            x = bx * T + ox
            pygame.draw.rect(scr, (120, 95, 70), (x - 8, by * T + 14, 48, 8), border_radius=2)
            pygame.draw.line(scr, (150, 122, 92), (x - 8, by * T + 15), (x + 40, by * T + 15), 1)
            pygame.draw.rect(scr, (90, 70, 55), (x - 4, by * T + 22, 6, 10))
            pygame.draw.rect(scr, (90, 70, 55), (x + 30, by * T + 22, 6, 10))
            pygame.draw.rect(scr, (120, 95, 70), (x - 8, by * T + 2, 6, 14))
            pygame.draw.line(scr, (70, 70, 90), (x + 44, by * T + 32), (x + 44, by * T - 20), 3)
            scr.blit(glow(46, (255, 190, 110)), (x + 44 - 46, by * T - 22 - 46))
            pygame.draw.circle(scr, (255, 226, 160), (x + 44, by * T - 22), 5)
        for name, ix, iy in s.room["items"]:
            if name not in s.taken:
                mx, my = ix * T + ox + 16, iy * T + 16 + math.sin(t * 3) * 4
                ic = ICON[name.split(":")[0].rstrip("0123456789")]
                scr.blit(glow(40, ic), (mx - 40, my - 40))
                pygame.draw.polygon(scr, ic, [(mx, my - 14), (mx + 14, my), (mx, my + 14), (mx - 14, my)])
                pygame.draw.polygon(scr, (210, 245, 255), [(mx, my - 14), (mx + 6, my - 2), (mx, my + 2), (mx - 6, my - 2)])
        sh = s.shade
        if sh and sh["room"] == s.ri:
            sx, sy = sh["x"] + ox, sh["y"] + math.sin(t * 3) * 3
            scr.blit(glow(40, (120, 130, 220)), (sx + 12 - 40, sy + 22 - 40))
            ss = pygame.Surface((24, 44), pygame.SRCALPHA)
            pygame.draw.ellipse(ss, (20, 20, 40, 200), (0, 0, 24, 44))
            pygame.draw.ellipse(ss, (140, 150, 230, 230), (0, 0, 24, 44), 2)
            pygame.draw.circle(ss, (255, 255, 255, 230), (8, 16), 2); pygame.draw.circle(ss, (255, 255, 255, 230), (16, 16), 2)
            scr.blit(ss, (sx, sy))
        for d in s.room["doors"]:
            draw_door(scr, d, ox, t)
            if s.state == "play" and p.rect.colliderect(door_rect(d)):
                s.text("W", s.font, (190, 225, 255), d["x"] * T + ox + 10, (d["y"] - 1) * T - 26)
        for n in s.room["npcs"]:
            draw_npc(scr, n, ox, t, p.x)
            if s.state == "play" and p.rect.colliderect(npc_rect(n)):
                s.text("W", s.font, (255, 230, 160), n["x"] * T + ox + 10, (n["y"] + 1) * T - 96)
        for e in s.en:
            DRAWERS[e.kind](scr, e, ox, t)
        for x, y, vx, life, vy, kind in s.shots:
            if kind != "wave":
                sx, yy = int(x) + ox, int(y)
                gc = (170, 240, 130) if kind == "spit" else ((255, 225, 120) if kind == "holy" else (190, 130, 255))
                scr.blit(glow(20, gc), (sx - 20, yy - 20))
                pygame.draw.circle(scr, shade(gc, 50), (sx, yy), 6)
                pygame.draw.circle(scr, (255, 255, 255), (sx - 2, yy - 2), 2)
                continue
            y = int(y)
            sx, d = int(x) + ox, (1 if vx > 0 else -1)
            scr.blit(glow(26, (255, 150, 60)), (sx - 26, y - 4))
            pygame.draw.polygon(scr, (200, 120, 50), [(sx - d * 14, y + 22), (sx - d * 6, y + 8), (sx + d * 2, y + 14),
                                                      (sx + d * 10, y), (sx + d * 16, y + 22)])
            pygame.draw.polygon(scr, (255, 200, 110), [(sx - d * 6, y + 22), (sx, y + 12), (sx + d * 8, y + 22)])
        if s.state in ("play", "talk", "pause") and (p.iframes <= 0 or int(p.iframes * 20) % 2):
            r = p.rect.move(ox, 0)
            if p.focus > 0:
                scr.blit(glow(46, (150, 200, 255)), (r.centerx - 46, r.centery - 46))
                pygame.draw.circle(scr, (150, 200, 255), r.center, 28 + int(math.sin(p.focus * 30) * 3), 2)
            draw_player(scr, p, ox, t)
            if p.dashing > 0:
                pygame.draw.line(scr, (140, 200, 255), (r.centerx - p.face * 44, r.centery), r.center, 4)
        if p.slash:
            sr = s.slash_rect().move(ox, 0)
            a0 = {"r": -1.0, "l": math.pi - 1.0, "up": math.pi / 2 - 1.0, "down": -math.pi / 2 - 1.0}[p.slash["dir"]]
            pygame.draw.arc(scr, (255, 255, 255), sr, a0, a0 + 2.0, 6)
            pygame.draw.arc(scr, (190, 215, 255), sr.inflate(-10, -10), a0, a0 + 2.0, 3)
        tn = s.room.get("tint")
        if tn:
            tc = s.__dict__.setdefault("_tints", {})
            if tn not in tc:
                ov = pygame.Surface((W, H), pygame.SRCALPHA); ov.fill((*tn, 34)); tc[tn] = ov
            scr.blit(tc[tn], (0, 0))
        if SETTINGS["vignette"]: scr.blit(A["vig"], (0, 0))
        # HUD
        for i in range(p.maxhp):
            c = (240, 240, 250) if i < p.hp else (70, 70, 90)
            pygame.draw.circle(scr, c, (34 + i * 30, 30), 11, 0 if i < p.hp else 2)
        pygame.draw.circle(scr, (60, 70, 100), (34, 84), 22, 2)
        scr.set_clip(pygame.Rect(0, 62 + int(44 * (1 - p.soul / 99)), W, 44))
        pygame.draw.circle(scr, (190, 220, 255) if p.soul >= 33 else (110, 140, 190), (34, 84), 20)
        scr.set_clip(None)
        pygame.draw.circle(scr, (240, 200, 90), (78, 84), 8)
        s.text(str(p.geo), s.font, (240, 220, 150), 94, 74)
        b = next((e for e in s.en if e.kind in BOSSES), None)
        if b:
            pygame.draw.rect(scr, (60, 30, 30), (W // 2 - 200, H - 30, 400, 10))
            pygame.draw.rect(scr, (220, 220, 230), (W // 2 - 200, H - 30, 400 * b.hp / b.maxhp, 10))
            s.text(BOSS_NAME[b.kind], s.font, (200, 200, 215), W // 2, H - 56, True)
        if s.note_t > 0:
            s.text(s.note, s.font, (255, 255, 255), W // 2, 40, True)
        if s.area_t > 0 and s.state == "play":
            s.text(s.room["name"], s.big, (215, 220, 240), W // 2, H // 2 - 220, True)
        if s.state == "talk":
            tk = s.talk; n = tk["npc"]
