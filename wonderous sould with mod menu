# ------------------------------------------------------------------ game
class Game:
    def __init__(s):
        pygame.init()
        try: s.scr = pygame.display.set_mode((W, H), pygame.SCALED)
        except Exception: s.scr = pygame.display.set_mode((W, H))
        pygame.display.set_caption("Wonderous Soul")
        try:
            pygame.mixer.init()
            s.music_ready = True
            s.sfx = make_game_sfx()
            s.sfx_channels = [pygame.mixer.Channel(i) for i in range(4)]
        except pygame.error:
            s.music_ready = False
            s.sfx = {}
            s.sfx_channels = []
        s.clock = pygame.time.Clock()
        s.font = pygame.font.SysFont("georgia", 20)
        s.big = pygame.font.SysFont("georgia", 54)
        s.mid = pygame.font.SysFont("georgia", 32)
        s.state = "title"
        s.art, s.props = make_art(), {}
        load_settings()
        s.mscreen, s.msel, s.mscroll, s.mreturn, s.confirm = "main", 0, 0.0, "main", None
        s.new_mode, s.slot, s.playtime, s.fs_on, s._cl, s.slots = False, 0, 0.0, False, None, [None] * 3
        s.mods = dict(god=False, infinite_soul=False, infinite_geo=False, unlock_all=False, one_hit=False,
                      no_cooldowns=False, super_speed=False, super_jump=False)
        s.mod_sel = 0
        s.refresh_slots(); s.apply_fullscreen()

    def play_sfx(s, name, volume=1.0):
        if not getattr(s, "music_ready", False):
            return
        snd = getattr(s, "sfx", {}).get(name)
        if snd is None:
            return
        try:
            snd.set_volume(max(0.0, min(1.0, volume)))
            snd.play()
        except pygame.error:
            pass

    def play_final_boss_music(s):
        """Start Blood Drain when entering the final-boss room."""
        if not getattr(s, "music_ready", False):
            s.say("Music system could not start.", 3)
            return
        # Build the path from the folder containing main.py so Windows can
        # run the game from any working directory.
        base = os.path.dirname(os.path.abspath(__file__))
        paths = [
            os.path.normpath(os.path.join(base, "music", "blood_drain.mp3")),
            os.path.normpath(os.path.join(base, "music", "blood_drain.ogg")),
        ]
        path = next((p for p in paths if os.path.isfile(p)), None)
        if path is None:
            s.say("Blood Drain NOT FOUND: music/blood_drain.mp3", 5)
            print("Blood Drain not found. Expected:", paths[0])
            return
        try:
            pygame.mixer.music.stop()
            pygame.mixer.music.load(path)
            pygame.mixer.music.set_volume(1.0)
            pygame.mixer.music.play(-1, fade_ms=400)
            s.say("Blood Drain playing!", 3)
            print("Blood Drain playing:", path)
        except Exception as exc:
            print("Final boss music error:", repr(exc))
            s.say("Blood Drain found, but Pygame could not play it.", 5)

    def stop_music(s):
        if getattr(s, "music_ready", False):
            try:
                pygame.mixer.music.fadeout(700)
            except pygame.error:
                pass

    def start(s, load=False):
        s.stop_music()
        s.p = Player()
        s.dead, s.taken, s.shade, s.shots = set(), set(), None, []
        s.spawn = (0, 4, 14)
        s.visited, s.bought, s.nail_lvl, s.focus_lvl, s.soul_lvl = set(), {}, 0, 0, 0
        s.show_map, s.talk, s.area_t = False, None, 0
        s.charms_owned, s.equipped, s.notches = set(), [], 4
        s.ch_sel, s.show_charms, s.ch_msg, s.ch_t = 0, False, "", 0
        s.playtime = 0.0
        s.shake = s.note_t = s.timer = s.cam = s.flash_t = 0
        s.note = ""
        if load: s.apply_save()
        s.respawn()
        s.state = "play"

    def say(s, text, t=4):
        s.note, s.note_t = text, t

    def load_room(s, i):
        if i != getattr(s, "ri", -1): s.area_t = 3.0
        s.ri, s.room, s.shots = i, dict(ROOMS[i]), []
        s.build_solids(); s.visited.add(i); s.p.cape = None
        s.en = [Enemy(k, x, y, (i, n)) for n, (k, x, y) in enumerate(s.room["spawns"])
                if (i, n) not in s.dead]
        if s.room.get("name") == "The Celestial Court":
            s.play_final_boss_music()
        else:
            # Only stop the special final-boss track when leaving its room.
            if getattr(s, "music_ready", False):
                try:
                    if pygame.mixer.music.get_busy():
                        pygame.mixer.music.fadeout(500)
                except pygame.error:
                    pass

    def refresh_slots(s):
        s.slots = [slot_info(i) for i in range(3)]

    def go(s, screen):
        s.mscreen, s.msel, s.mscroll, s.confirm = screen, 0, 0.0, None
        s.refresh_slots()

    def to_menu(s):
        s.state, s.mreturn = "title", "main"
        s.go("main")

    def open_pause(s):
        s.state, s.mreturn = "pause", "pause"
        s.go("pause")

    def apply_fullscreen(s):
        want = bool(SETTINGS["fullscreen"])
        if want != s.fs_on:
            try: pygame.display.toggle_fullscreen()
            except Exception: pass
            s.fs_on = want

    def menu_items(s):
        if s.mscreen == "pause": return ["Resume", "Mod Menu", "Settings", "Controls", "Main Menu", "Quit"]
        items = ["Start", "Saves", "Settings", "Controls", "Changelog", "Credits", "Quit"]
        if any(s.slots): items.insert(1, "Continue")
        return items

    def settings_rows(s):
        onoff = lambda v: "On" if v else "Off"
        return [("Difficulty", SETTINGS["diff"]), ("Screen shake", onoff(SETTINGS["shake"])),
                ("Vignette", onoff(SETTINGS["vignette"])), ("Show FPS", onoff(SETTINGS["fps"])),
                ("Fullscreen", onoff(SETTINGS["fullscreen"])), ("Reset to defaults", ""), ("Back", "")]

    def change_setting(s, i, d):
        keys = ["diff", "shake", "vignette", "fps", "fullscreen"]
        if i < 5:
            k = keys[i]
            if k == "diff":
                order = ["Easy", "Normal", "Hard"]
                SETTINGS[k] = order[(order.index(SETTINGS[k]) + d) % 3]
            else:
                SETTINGS[k] = not SETTINGS[k]
                if k == "fullscreen": s.apply_fullscreen()
        elif i == 5:
            keep = SETTINGS["last_slot"]
            SETTINGS.update(DEFAULT_SETTINGS); SETTINGS["last_slot"] = keep
            s.apply_fullscreen()
        else:
            s.go(s.mreturn); return
        save_settings()

    def begin(s, load):
        SETTINGS["last_slot"] = s.slot; save_settings()
        s.start(load=load)

    def menu_select(s, it):
        origin = s.mscreen
        if it == "Resume": s.state = "play"
        elif it == "Main Menu": s.to_menu()
        elif it == "Quit": pygame.quit(); sys.exit()
        elif it == "Continue":
            sl = SETTINGS.get("last_slot", 0)
            if not s.slots[sl]: sl = next(i for i in range(3) if s.slots[i])
            s.slot = sl; s.begin(True)
        elif it == "Mod Menu":
            s.mreturn = origin; s.mscreen = "mods"; s.msel = 0
        else:
            s.mreturn = origin
            s.new_mode = it == "Start"
            s.go({"Start": "saves", "Saves": "saves", "Settings": "settings", "Controls": "controls",
                  "Changelog": "changelog", "Credits": "credits"}[it])
            if it in ("Start", "Saves"): s.msel = SETTINGS.get("last_slot", 0)

    def run_confirm(s):
        kind, i = s.confirm
        s.confirm = None
        if kind == "delete":
            try: os.remove(SAVE_FILES[i])
            except OSError: pass
            s.refresh_slots()
        else:
            s.slot = i; s.begin(False)

    def mod_rows(s):
        onoff = lambda v: "ON" if v else "OFF"
        return [
            ("Teleport to Final Boss", "", "Warp directly to The Seraph"),
            ("God Mode", onoff(s.mods["god"]), "Take no damage"),
            ("Infinite Soul", onoff(s.mods["infinite_soul"]), "Keep Soul at 99"),
            ("Infinite Geo", onoff(s.mods["infinite_geo"]), "Keep Geo at 99,999"),
            ("Unlock Everything", onoff(s.mods["unlock_all"]), "Unlock dash, wings, claw and upgrades"),
            ("One-Hit Kill", onoff(s.mods["one_hit"]), "Normal enemies die in one slash"),
