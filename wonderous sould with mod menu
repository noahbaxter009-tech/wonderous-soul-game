def update_cape(p, dt, t):
    N, seg = 5, 5.0
    ax, ay = p.x + p.w / 2 - p.face * 3, p.y + 21
    if p.cape is None or math.hypot(p.cape[1][0] - ax, p.cape[1][1] - ay) > 90:
        p.cape = [[ax - p.face * i * 2, ay + i * seg * 0.9] for i in range(N)]
    c = p.cape
    c[0] = [ax, ay]
    sp = abs(p.vx) / 300
    k = min(1, 14 * dt)
    for i in range(1, N):
        px, py = c[i - 1]; x, y = c[i]
        tx = px - p.vx * 0.045 * (1 + i * 0.1) - p.face * 2 + math.sin(t * 7 + i * 0.9) * (1 + sp * 3)
        ty = py + seg * 0.9 - p.vy * 0.012 + math.sin(t * 5 + i) * 0.6
        x += (tx - x) * k; y += (ty - y) * k
        dx, dy = x - px, y - py
        d = math.hypot(dx, dy) or 1
        if d > seg: x, y = px + dx / d * seg, py + dy / d * seg
        c[i] = [x, y]


def draw_cape(scr, pts, ox, col=(105, 108, 118)):
    L, R = [], []
    n = len(pts)
    for i, (x, y) in enumerate(pts):
        nx, ny = pts[min(i + 1, n - 1)]; px, py = pts[max(i - 1, 0)]
        dx, dy = nx - px, ny - py
        d = math.hypot(dx, dy) or 1
        w = 3 + i * 1.7
        L.append((x + ox - dy / d * w, y + dx / d * w))
        R.append((x + ox + dy / d * w, y - dx / d * w))
    poly = L + R[::-1]
    pygame.draw.polygon(scr, col, poly)
    pygame.draw.lines(scr, shade(col, 45), False, [(x + ox, y) for x, y in pts[1:]], 2)
    pygame.draw.polygon(scr, shade(col, -40), poly, 2)


def ik(hip, foot, l1, l2, bend):
    dx, dy = foot[0] - hip[0], foot[1] - hip[1]
    dist = math.hypot(dx, dy) or 1
    d = min(dist, l1 + l2 - 0.5)
    a = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
    h = math.sqrt(max(0, l1 * l1 - a * a))
    ux, uy = dx / dist, dy / dist
    return (hip[0] + ux * a - uy * h * bend, hip[1] + uy * a + ux * h * bend)


def draw_player(scr, p, ox, t):
    """Draw the knight as one connected body with three horns and a short gray cape."""
    R = p.rect.move(ox, 0)
    f = p.face

    # Wings remain behind the body when unlocked.
    if p.has_wings and not p.ground:
        fw = math.sin(t * 20) * 6
        for s_ in (-1, 1):
            pygame.draw.polygon(scr, (255, 245, 190), [
                (R.centerx + s_ * 3, R.y + 24),
                (R.centerx + s_ * 24, R.y + 10 + fw),
                (R.centerx + s_ * 18, R.y + 30)])

    if p.cape:
        draw_cape(scr, p.cape, ox, (105, 108, 118))

    sf = pygame.Surface((110, 120), pygame.SRCALPHA)
    r = pygame.Rect(43, 44, p.w, p.h)
    cx = r.centerx
    moving = p.ground and abs(p.vx) > 20 and p.knock <= 0
    spd = min(1.0, abs(p.vx) / 290)
    bob = -abs(math.sin(p.walk_t)) * 2.2 * spd if moving else math.sin(t * 2.2) * 0.5
    lean = max(-1, min(1, p.vx / 290)) * 2.5 if p.knock <= 0 else 0

    # A single connected dark cloak/body instead of separate animated limbs.
    body_top = r.y + 20 + bob
    body_bottom = r.bottom - 2
    body_left = cx - 10 + lean
    body_right = cx + 10 + lean
    pygame.draw.ellipse(sf, (16, 17, 28),
                        (body_left - 4, body_top + 2, 28, 18))
    pygame.draw.polygon(sf, (22, 23, 36), [
        (body_left + 1, body_top + 10),
        (body_right - 1, body_top + 10),
        (body_right + 5, body_bottom - 7),
        (cx + 5, body_bottom + 1),
        (cx - 6, body_bottom + 1),
        (body_left - 5, body_bottom - 7),
    ])
    pygame.draw.polygon(sf, (48, 49, 65), [
        (cx - 7, body_top + 11), (cx + 1, body_top + 11),
        (cx + 5, body_bottom - 6), (cx, body_bottom - 1),
        (cx - 5, body_bottom - 6)
    ])

    # Short gray shoulder cape/collar.
    pygame.draw.polygon(sf, (105, 108, 118), [
        (cx - 12, body_top + 5), (cx - 5, body_top + 12),
        (cx, body_top + 8), (cx + 5, body_top + 12),
        (cx + 12, body_top + 5), (cx + 8, body_top - 1),
        (cx, body_top + 3), (cx - 8, body_top - 1)
    ])

    # Head.
    hx = cx + lean
    hy = r.y + bob - 3
    pygame.draw.ellipse(sf, (226, 226, 238), (hx - 12, hy + 2, 24, 22))
    pygame.draw.ellipse(sf, (248, 248, 254), (hx - 9 + f * 2, hy + 4, 14, 8))
    pygame.draw.ellipse(sf, (190, 190, 210), (hx - 12, hy + 2, 24, 22), 2)

    # Three horns: two outer horns plus a central crown-like horn.
    horn_col = (238, 238, 246)
    horn_shadow = (205, 205, 220)
    pygame.draw.polygon(sf, horn_col, [
        (hx - 8, hy + 8), (hx - 12, hy - 1), (hx - 10, hy - 10),
        (hx - 5, hy - 1), (hx - 3, hy + 8)
    ])
    pygame.draw.polygon(sf, horn_col, [
        (hx - 2, hy + 5), (hx, hy - 13), (hx + 3, hy + 5)
    ])
    pygame.draw.polygon(sf, horn_col, [
        (hx + 3, hy + 8), (hx + 9, hy - 1), (hx + 11, hy - 10),
        (hx + 12, hy - 1), (hx + 8, hy + 9)
    ])
    pygame.draw.line(sf, horn_shadow, (hx, hy - 11), (hx + 1, hy + 3), 1)

    # Eyes.
    for s_ in (-1, 1):
        pygame.draw.ellipse(sf, (12, 12, 20),
                            (hx + s_ * 5 + f * 2 - 3, hy + 11, 6, 8))

    # Nail arm is attached to the body rather than being a separate limb.
    hand = (cx + f * 7 + lean, body_top + 12)
    if p.slash:
        v = {"up": (0, -1), "down": (0, 1), "l": (-1, 0), "r": (1, 0)}[p.slash["dir"]]
    else:
        v = (-f * 0.4, 0.9)
    tip = (hand[0] + v[0] * 24, hand[1] + v[1] * 24)
    pygame.draw.line(sf, (48, 49, 65), (cx + f * 3, body_top + 8), hand, 5)
    pygame.draw.line(sf, (222, 226, 238), hand, tip, 3)
    pygame.draw.line(sf, (120, 110, 100),
                     (hand[0] - v[0] * 3, hand[1] - v[1] * 3), hand, 4)

    # Squash/stretch keeps the whole body feeling alive without separating it into limbs.
    sx = sy = 1.0
    if p.land_t > 0:
        k = p.land_t / 0.18 * p.land_amt
        sy, sx = 1 - 0.20 * k, 1 + 0.16 * k
    elif not p.ground:
        k = min(1.0, abs(p.vy) / 700)
        sy, sx = 1 + 0.12 * k, 1 - 0.07 * k
    if p.jump_t > 0:
        sy += 0.10 * p.jump_t / 0.2; sx -= 0.06 * p.jump_t / 0.2
    if abs(sx - 1) > 0.01 or abs(sy - 1) > 0.01:
        sf = pygame.transform.smoothscale(sf, (int(110 * sx), int(120 * sy)))
    scr.blit(sf, (R.centerx - int(cx * sx), R.bottom - int(r.bottom * sy)))


