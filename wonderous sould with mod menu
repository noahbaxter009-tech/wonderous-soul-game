def build_changelog(font):
    out = []
    for ver, title, notes in CHANGELOG:
        out.append(("h", "v" + ver + "  -  " + title))
        for n in notes:
            for k, ln in enumerate(wrap(font, n, 740)): out.append(("t", ("•  " if k == 0 else "     ") + ln))
        out.append(("t", ""))
    return out
