                v = (cx * 7 + cy * 13) % 6
                if cy > 0 and (cx, cy - 1) not in sol:
                    scr.blit(A["top"][v], (x, y - 8))
                else:
                    scr.blit(A["stone"][v], (x, y))
                if cy < 16 and (cx, cy + 1) not in sol:
                    pygame.draw.line(scr, (22, 24, 40), (x, y + T - 2), (x + T, y + T - 2), 3)
                if (cx, cy) in s.room["gate"]:
