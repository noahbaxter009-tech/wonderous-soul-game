                    s.text(str(k + 1) + ")  " + lbl + "  -  " + price, s.font, (220, 224, 240), box.x + 18, box.y + 44 + k * 30)
                s.text("Your Geo: " + str(p.geo) + "     Press 1-" + str(len(n["shop"])) + " to buy,  Enter to leave",
                       s.font, (130, 140, 180), box.x + 18, box.bottom - 34)
        if s.show_charms:
