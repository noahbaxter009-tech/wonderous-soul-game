def solids(room, r):
    out = []
    for cx in range(r.left // T, (r.right - 1) // T + 1):
        for cy in range(r.top // T, (r.bottom - 1) // T + 1):
            if (cx, cy) in room["solid"]:
                out.append(pygame.Rect(cx * T, cy * T, T, T))
    return out


class Body:
    def __init__(s, x, y, w, h):
        s.x, s.y, s.w, s.h = x, y, w, h
        s.vx = s.vy = 0
        s.ground, s.wall = False, 0

    @property
    def rect(s):
        return pygame.Rect(int(s.x), int(s.y), s.w, s.h)

    def move(s, room, dt, grav=True):
        if grav: s.vy = min(s.vy + GRAV * dt, MAXFALL)
        s.wall, s.ground = 0, False
        s.x += s.vx * dt
        r, hit = s.rect, False
        for t in solids(room, r):
            hit = True
            if s.vx > 0: r.right = t.left; s.wall = 1
            elif s.vx < 0: r.left = t.right; s.wall = -1
        if hit: s.x = r.x
        vy0 = s.vy
        s.y += s.vy * dt
        r, hit = s.rect, False
        for t in solids(room, r):
            hit = True
            if vy0 > 0: r.bottom = t.top; s.ground = True
            elif vy0 < 0: r.top = t.bottom
        if hit: s.y = r.y; s.vy = 0
        if not s.ground and s.vy >= 0 and solids(room, s.rect.move(0, 1)):
            s.ground = True; s.vy = 0


class Player(Body):
    def __init__(s):
        super().__init__(0, 0, 24, 44)
        s.face, s.hp, s.maxhp, s.soul, s.geo = 1, 5, 5, 0, 0
        s.iframes = s.knock = s.dash_cd = s.atk_cd = s.focus = s.buf = s.coyote = s.dashing = 0
        s.air_dash, s.jumping, s.has_dash = True, False, False
        s.has_wings = s.has_claw = False; s.air_jumps = 1; s.wj = 0
        s.land_t = s.land_amt = s.jump_t = 0.0
        s.slash, s.safe = None, (0, 0)
        s.cape, s.walk_t = None, 0.0
        s.last_step_cycle = -1


class Enemy(Body):
    STATS = {"crawl": (34, 22, 10, 1, 3), "fly": (28, 28, 10, 1, 5), "boss": (80, 90, 120, 2, 60),
             "spitter": (30, 38, 15, 1, 6), "hopper": (32, 26, 15, 1, 6), "tank": (48, 34, 30, 1, 12),
             "bat": (26, 22, 10, 1, 5), "ghost": (26, 36, 20, 1, 10),
             "weaver": (70, 60, 160, 2, 120), "warden": (90, 100, 220, 2, 200), "seraph": (8, 8, 360, 2, 500)}

    def __init__(s, kind, cx, cy, eid):
        w, h, s.hp, s.dmg, s.geo = Enemy.STATS[kind]
        dep = ROOM_DEPTH.get(eid[0], 0)
        if kind != "seraph": s.hp = int(s.hp * (1 + 0.35 * dep))
        s.geo = int(s.geo * (1 + 0.3 * dep))
        if dep >= 3 and kind not in BOSSES: s.dmg = 2
        s.hp = max(1, int(s.hp * DIFF[SETTINGS["diff"]][0]))
        s.maxhp = s.hp
        super().__init__(cx * T, cy * T if kind in FLYERS else (cy + 1) * T - h, w, h)
        s.kind, s.id, s.flash, s.stun = kind, eid, 0, 0
        s.dir, s.t, s.state, s.cycle, s.age = -1, 1.0, "idle", 0, random.random() * 6
        s.face = -1; s.home = (s.x, s.y); s.cd = 0
        if kind == "bat": s.state = "hang"
        if kind == "spitter": s.t = 1.0 + random.random()
        if kind == "hopper": s.t = random.random() * 1.5
        if kind == "seraph":
            s.ax = cx * T + 16
            s.x = s.y = -5000.0
            s.phase, s.state, s.cool, s.t, s.intro_said = 1, "intro", 2.0, 3.0, False
            s.sched, s.bolts, s.hands = [], [], []

    def add_bolt(s, x, warn):
        s.bolts.append(dict(x=x, warn=warn, t=0.0, state="warn"))

    def add_hand(s, x):
        s.hands.append(dict(x=x, y=-260.0, t=0.0, state="warn"))

    def ring(s, g):
        rot = random.random() * 6.28
        for i in range(14):
            a = rot + i * math.tau / 14
            g.shots.append([s.ax, 110, math.cos(a) * 250, 4.5, math.sin(a) * 250, "holy"])

    def seraph_ai(s, g, dt):
        p, rw = g.p, g.room["w"] * T
        s.x = s.y = -5000.0
        ph = 1 if s.hp > s.maxhp * 0.66 else (2 if s.hp > s.maxhp * 0.33 else 3)
        warn = {1: 1.0, 2: 0.8, 3: 0.65}[s.phase]
        if s.state == "intro":
            if not s.intro_said:
                s.intro_said = True; g.say("A vast light opens its eyes...", 3)
            s.t -= dt
            if s.t <= 0: s.state, s.cool = "fight", 1.0
            return
        if s.state == "phase":
            s.t -= dt
            if s.t <= 0: s.state, s.cool = "fight", 1.2
            return
        if ph > s.phase:
            s.phase, s.state, s.t = ph, "phase", 2.5
            s.sched, s.bolts, s.hands = [], [], []
            g.shake = 0.6
            g.say("JUDGEMENT DRAWS NEAR!" if ph == 3 else "The light grows fierce...", 3)
            return
        for it in list(s.sched):
            it[0] -= dt
            if it[0] <= 0:
                s.sched.remove(it); it[1]()
        for b in list(s.bolts):
            b["t"] += dt
            if b["state"] == "warn" and b["t"] >= b["warn"]:
                b["state"], b["t"] = "strike", 0.0
                g.shake = max(g.shake, 0.12)
            elif b["state"] == "strike":
                if abs(p.x + p.w / 2 - b["x"]) < 30 and g.state == "play": g.hurt(2, b["x"])
                if b["t"] >= 0.22: s.bolts.remove(b)
        floor = 15 * T
        for h in list(s.hands):
            h["t"] += dt
            if h["state"] == "warn":
                if h["t"] >= 1.0: h["state"], h["t"] = "fall", 0.0
            elif h["state"] == "fall":
                h["y"] += 2400 * dt
                if g.state == "play" and p.rect.colliderect(pygame.Rect(int(h["x"]) - 75, int(h["y"]), 150, 170).inflate(-20, -10)):
                    g.hurt(2, h["x"])
                if h["y"] + 170 >= floor:
                    h["y"] = floor - 170; h["state"], h["t"] = "rest", 0.0
                    g.shake = 0.4
                    for d in (-1, 1): g.shots.append([h["x"], floor - 22, d * 360, 1.8, 0, "wave"])
            elif h["state"] == "rest":
                if h["t"] >= 3.2: h["state"], h["t"] = "rise", 0.0
            else:
                h["y"] -= 900 * dt
                if h["y"] < -260: s.hands.remove(h)
        s.cool -= dt
        if s.cool <= 0 and not s.sched:
            opts = ["track", "row", "hand"]
            if s.phase >= 2: opts.append("rings")
            if s.phase >= 3: opts.append("sweep")
            if any(h["state"] in ("warn", "fall", "rest") for h in s.hands): opts.remove("hand")
            a = random.choice(opts)
            cx = p.x + p.w / 2
            if a == "track":
                n = 3 if s.phase == 1 else 5
                for i in range(n):
                    s.sched.append([i * 0.5, lambda: s.add_bolt(p.x + p.w / 2, warn)])
                s.cool = 1.8 + n * 0.5
            elif a == "row":
                c, gap = int(cx // 160) * 160, random.randint(-2, 2)
                for k in range(-3, 4):
                    if k != gap: s.add_bolt(max(40, min(rw - 40, c + k * 160 + 80)), warn + 0.25)
                s.cool = 3.0
            elif a == "hand":
                xs = [cx]
                if s.phase >= 2: xs.append(cx + random.choice((-320, 320)))
                for x in xs: s.add_hand(max(120, min(rw - 120, x)))
                s.cool = 5.0
            elif a == "rings":
                for i in range(2): s.sched.append([i * 1.0, lambda: s.ring(g)])
                s.cool = 4.0
            else:
                cols = list(range(60 + random.randint(0, 80), int(rw) - 60, 140))
                if random.random() < 0.5: cols.reverse()
                for i, x in enumerate(cols): s.sched.append([i * 0.14, (lambda x=x: s.add_bolt(x, warn))])
                s.cool = 2.0 + len(cols) * 0.14
            if s.phase == 3: s.cool *= 0.8

    def update(s, g, dt):
        p, room = g.p, g.room
        s.flash = max(0, s.flash - dt); s.age += dt
        if s.stun > 0:
            s.stun -= dt; s.vx *= 0.92
            s.move(room, dt, s.kind not in FLYERS); return
        if s.kind == "crawl":
            r = s.rect
            ax = r.right + 2 if s.dir > 0 else r.left - 2
            if s.wall or (ax // T, (r.bottom + 2) // T) not in room["solid"]:
                s.dir *= -1
            s.vx = 60 * s.dir
            s.move(room, dt)
        elif s.kind == "fly":
            dx, dy = p.x - s.x, p.y - s.y
            d = math.hypot(dx, dy) or 1
            tvx, tvy = (dx / d * 130, dy / d * 130) if d < 330 else (0, 0)
            tvy += math.sin(s.age * 4) * 40
            s.vx += (tvx - s.vx) * min(1, 4 * dt)
            s.vy += (tvy - s.vy) * min(1, 4 * dt)
            s.move(room, dt, False)
        elif s.kind == "spitter":
            s.face = 1 if p.x > s.x else -1
            s.t -= dt
            if s.t <= 0:
                s.t = 2.2
                if abs(p.x - s.x) < 460 and abs(p.y - s.y) < 320:
                    vx = max(-300, min(300, (p.x - s.x) * 0.85))
                    g.shots.append([s.rect.centerx + s.face * 8, s.y + 8, vx, 3.0, -420, "spit"])
            s.move(room, dt)
        elif s.kind == "hopper":
            s.face = 1 if p.x > s.x else -1
            if s.ground:
                s.vx = 0; s.t -= dt
                if s.t <= 0:
                    near = abs(p.x - s.x) < 420
                    s.vy, s.vx = -620, (s.face if near else random.choice((-1, 1))) * 210
                    s.t = random.uniform(0.9, 1.5)
            s.move(room, dt)
        elif s.kind == "tank":
            r = s.rect
            chase = abs(p.x - s.x) < 520 and abs(p.y - s.y) < 140
            if chase: s.dir = 1 if p.x > s.x else -1
            ax = r.right + 2 if s.dir > 0 else r.left - 2
            blocked = s.wall or (ax // T, (r.bottom + 2) // T) not in room["solid"]
            if blocked and not chase: s.dir *= -1
            s.vx = 0 if blocked else (62 if chase else 34) * s.dir
            s.move(room, dt)
        elif s.kind == "bat":
            d = math.hypot(p.x - s.x, p.y - s.y) or 1
            s.cd = max(0, s.cd - dt)
            if s.state == "hang":
                s.vx = s.vy = 0
                if d < 280 and s.cd <= 0:
                    s.state, s.t = "swoop", 0.9
                    s.vx, s.vy = (p.x - s.x) / d * 400, (p.y + 10 - s.y) / d * 400
            elif s.state == "swoop":
                s.t -= dt
                if s.t <= 0 or s.wall or s.ground: s.state = "back"
            else:
                hx, hy = s.home[0] - s.x, s.home[1] - s.y
                hd = math.hypot(hx, hy) or 1
                if hd < 10:
                    s.state, s.cd, s.vx, s.vy = "hang", 1.2, 0, 0
                    s.x, s.y = s.home
                else:
                    s.vx, s.vy = hx / hd * 200, hy / hd * 200
            s.move(room, dt, False)
        elif s.kind == "ghost":
            dx, dy = p.x - s.x, p.y - s.y
            d = math.hypot(dx, dy) or 1
            sp = 70 if d < 520 else 0
            s.vx += ((dx / d * sp) - s.vx) * min(1, 1.5 * dt)
            s.vy += ((dy / d * sp + math.sin(s.age * 2) * 30) - s.vy) * min(1, 1.5 * dt)
            s.x += s.vx * dt; s.y += s.vy * dt
        elif s.kind == "weaver":
            s.face = 1 if p.x > s.x else -1
            cx, cy = s.x + s.w / 2, s.y + s.h / 2
            s.t -= dt
            if s.state == "idle":
                tx, ty = p.x - s.w / 2 + 12, max(2 * T, p.y - 180)
                s.vx = max(-260, min(260, (tx - s.x) * 1.6)); s.vy = max(-200, min(200, (ty - s.y) * 2))
                if s.t <= 0:
                    s.cycle += 1
                    s.state, s.t = ("dive", 0.6) if s.cycle % 3 == 0 else ("fan", 0.5)
            elif s.state == "fan":
                s.vx = s.vy = 0
                if s.t <= 0:
                    base = math.atan2(p.y - cy, p.x - cx)
                    for a in (-0.5, -0.25, 0, 0.25, 0.5):
                        g.shots.append([cx, cy, math.cos(base + a) * 300, 4.0, math.sin(base + a) * 300, "orb"])
                    s.state, s.t = "idle", 1.5
            elif s.state == "dive":
                s.vx = s.vy = 0
                if s.t <= 0: s.state, s.vy = "slam", 820
            else:
                if s.ground:
                    g.shake = 0.35
                    for d in (-1, 1):
                        g.shots.append([s.rect.centerx, s.rect.bottom - 22, d * 380, 1.6, 0, "wave"])
                    s.state, s.t, s.vy = "idle", 1.4, 0
            s.move(room, dt, False)
        elif s.kind == "seraph":
            s.seraph_ai(g, dt)
        elif s.kind in ("boss", "warden"):
            face = s.face = 1 if p.x > s.x else -1
            sp = 1.35 if s.kind == "warden" else 1
            if s.state == "idle":
                s.vx = 0; s.t -= dt
                if s.t <= 0:
                    s.cycle += 1
                    if s.cycle % 3 == 0: s.state, s.t, s.vx = "charge", 0.7, face * 520 * sp
                    else: s.state, s.t, s.vy, s.vx = "air", 0.2, -950, face * 300 * sp
            elif s.state == "charge":
                s.t -= dt
                if s.t <= 0 or s.wall: s.state, s.t, s.vx = "idle", 0.9, 0
            elif s.state == "air":
                s.t -= dt
                if s.ground and s.t <= 0:
                    s.state, s.t, s.vx = "idle", 1.0, 0
                    g.shake = 0.3
                    for d in (-1, 1):
                        g.shots.append([s.rect.centerx, s.rect.bottom - 22, d * 380, 1.6, 0, "wave"])
                    if s.kind == "warden":
                        for vx in (-210, -80, 80, 210):
                            g.shots.append([s.rect.centerx, s.rect.y, vx, 3.0, -640, "spit"])
            s.move(room, dt)


