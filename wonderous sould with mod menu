    def apply_mods(s):
        if not hasattr(s, "mods") or not hasattr(s, "p"): return
        p = s.p
        if s.mods["infinite_geo"]: p.geo = 99999
        if s.mods["infinite_soul"]: p.soul = 99
        if s.mods["unlock_all"]:
            p.has_dash = p.has_wings = p.has_claw = True
            p.air_jumps = max(p.air_jumps, 1)
            s.nail_lvl = max(s.nail_lvl, 5); s.focus_lvl = max(s.focus_lvl, 1); s.soul_lvl = max(s.soul_lvl, 2)
        if s.mods["no_cooldowns"]:
            p.dash_cd = p.atk_cd = 0
        if s.mods["god"]:
            p.iframes = max(p.iframes, 0.1)
        if s.mods["unlock_all"] and p.maxhp < 9:
            p.maxhp = 9; p.hp = max(p.hp, p.maxhp)

    def mod_action(s, i):
        if i == 0:
            target = next((j for j, r in enumerate(ROOMS) if r.get("name") == "The Celestial Court"), None)
            if target is not None:
                s.load_room(target)
                s.p.x = 25 * T + 4
                s.p.y = 14 * T - s.p.h
                s.p.vx = s.p.vy = 0
                s.p.iframes = 1.0
                s.state = "play"
                s.say("Teleported to the final boss.", 2)
        elif i <= 8:
            keys = ["god", "infinite_soul", "infinite_geo", "unlock_all", "one_hit", "no_cooldowns", "super_speed", "super_jump"]
            k = keys[i - 1]
            s.mods[k] = not s.mods[k]
            s.say(k.replace("_", " ").title() + (" enabled." if s.mods[k] else " disabled."), 1.5)
        elif i == 9:
            s.p.hp = s.p.maxhp; s.say("Fully healed.", 1.5)
        elif i == 10:
            for e in list(s.en):
                s.dead.add(e.id); s.p.geo += int(e.geo * (1.5 if s.eq("greed") else 1))
            s.en.clear(); s.build_solids(); s.say("All enemies defeated in this room.", 2)
        elif i == 11:
            s.mods.update(god=True, infinite_soul=True, infinite_geo=True, unlock_all=True, no_cooldowns=True)
            s.p.maxhp = 9; s.p.hp = 9; s.p.soul = 99; s.p.geo = 99999; s.p.has_dash = s.p.has_wings = s.p.has_claw = True
            s.nail_lvl = 5; s.focus_lvl = 1; s.soul_lvl = 2
            s.say("All mods enabled and player maxed out.", 2.5)
        else:
            s.go(s.mreturn)

    def menu_input(s, pressed, dt):
        K = pygame
        up, down = pressed & {K.K_w, K.K_UP}, pressed & {K.K_s, K.K_DOWN}
        left, right = pressed & {K.K_a, K.K_LEFT}, pressed & {K.K_d, K.K_RIGHT}
        ok = pressed & {K.K_RETURN, K.K_KP_ENTER, K.K_SPACE}
        back = pressed & {K.K_ESCAPE, K.K_BACKSPACE}
        sc = s.mscreen
        if s.confirm:
            if ok: s.run_confirm()
            elif back: s.confirm = None
            return
        if sc in ("main", "pause"):
            items = s.menu_items(); n = len(items)
            if up: s.msel = (s.msel - 1) % n
            if down: s.msel = (s.msel + 1) % n
            if ok: s.menu_select(items[s.msel])
            elif back and sc == "pause": s.state = "play"
        elif sc == "saves":
            if up: s.msel = (s.msel - 1) % 3
            if down: s.msel = (s.msel + 1) % 3
            if ok:
                s.slot = s.msel
                if s.slots[s.msel] and s.new_mode: s.confirm = ("overwrite", s.msel)
                else: s.begin(bool(s.slots[s.msel]))
            elif pressed & {K.K_x, K.K_DELETE}:
                if s.slots[s.msel]: s.confirm = ("delete", s.msel)
            elif back: s.go(s.mreturn)
        elif sc == "settings":
            if up: s.msel = (s.msel - 1) % 7
            if down: s.msel = (s.msel + 1) % 7
            if left: s.change_setting(s.msel, -1)
            elif right or ok: s.change_setting(s.msel, 1)
            elif back: s.go(s.mreturn)
        elif sc == "mods":
            n = len(s.mod_rows())
            if up: s.msel = (s.msel - 1) % n
            if down: s.msel = (s.msel + 1) % n
            if left or right or ok: s.mod_action(s.msel)
            elif back: s.go(s.mreturn)
            s.mscroll = max(0, min(max(0, n - 10), s.msel - 5))
        else:
            if sc == "changelog":
                k = K.key.get_pressed()
                s.mscroll += (int(bool(k[K.K_s] or k[K.K_DOWN])) - int(bool(k[K.K_w] or k[K.K_UP]))) * 420 * dt
            if back: s.go(s.mreturn)

