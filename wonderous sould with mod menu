            scr.fill((10, 10, 20))
            s.text("The Seraph has returned to the light.", s.big, (230, 230, 245), W // 2, 200, True)
            s.text(f"Geo collected: {s.p.geo}     Press ENTER for the main menu", s.font, (170, 175, 200), W // 2, 290, True)

    def text(s, t, f, c, x, y, center=False):
        im = f.render(t, True, c)
        s.scr.blit(im, im.get_rect(midtop=(x, y)) if center else (x, y))

    def run(s):
        while True:
            dt = min(s.clock.tick(60) / 1000, 1 / 30)
            pressed = set()
            for ev in pygame.event.get():
                if ev.type == pygame.QUIT:
                    s.stop_music()
                    pygame.quit(); sys.exit()
                if ev.type == pygame.KEYDOWN: pressed.add(ev.key)
            st = s.state
            if st == "play" and pygame.K_F2 in pressed:
                s.open_pause(); s.mscreen, s.msel = "mods", 0
            elif st in ("title", "pause"):
                s.menu_input(pressed, dt)
            elif st == "win":
                if pressed & {pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_ESCAPE}: s.to_menu()
            elif st == "talk":
                if pygame.K_ESCAPE in pressed: s.state = "play"
                else: s.talk_update(pressed)
            elif st == "play":
                if pygame.K_ESCAPE in pressed:
                    if s.show_map or s.show_charms: s.show_map = s.show_charms = False
                    else: s.open_pause()
                else:
                    if pygame.K_m in pressed: s.show_map = not s.show_map; s.show_charms = False
                    if pygame.K_i in pressed: s.show_charms = not s.show_charms; s.show_map = False
                    if s.show_charms: s.charm_input(pressed)
                    elif not s.show_map: s.update(dt, pressed)
            elif st == "dead":
                s.timer -= dt
                if s.timer <= 0: s.respawn(); s.state = "play"
            s.draw()
            pygame.display.flip()


if __name__ == "__main__":
    Game().run()
