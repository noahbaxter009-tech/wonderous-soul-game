            pygame.draw.rect(scr, (140, 150, 190), box, 2, border_radius=10)
            s.text(n["name"], s.font, (255, 230, 160), box.x + 18, box.y + 12)
            if not tk["shop"]:
                for k, ln in enumerate(wrap(s.font, n["lines"][tk["i"]], box.w - 40)):
