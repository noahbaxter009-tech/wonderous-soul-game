    def eq(s, key):
        return key in s.equipped

    def notch_used(s):
        return sum(CHARMS[k]["cost"] for k in s.equipped)

    def focus_time(s):
        ft = 0.65 if s.focus_lvl else 1.0
        return min(ft, 0.45) if s.eq("quick_focus") else ft

    def toggle_charm(s, k):
        p = s.p
        if k in s.equipped:
            s.equipped.remove(k)
            if k == "fragile_heart": p.maxhp -= 2; p.hp = min(p.hp, p.maxhp)
        elif s.notch_used() + CHARMS[k]["cost"] <= s.notches:
            s.equipped.append(k)
            if k == "fragile_heart": p.maxhp += 2; p.hp += 2
        else:
            s.ch_msg, s.ch_t = "Not enough charm notches.", 90

    def charm_input(s, pressed):
        s.ch_t = max(0, s.ch_t - 1)
        own = [k for k in CHARMS if k in s.charms_owned]
        if not own: return
        s.ch_sel %= len(own)
        if pressed & {pygame.K_d, pygame.K_RIGHT}: s.ch_sel = (s.ch_sel + 1) % len(own)
        if pressed & {pygame.K_a, pygame.K_LEFT}: s.ch_sel = (s.ch_sel - 1) % len(own)
        if pressed & {pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE}: s.toggle_charm(own[s.ch_sel])

    def save(s):
        p = s.p
        data = dict(spawn=list(s.spawn), geo=p.geo, maxhp=p.maxhp, dash=p.has_dash, wings=p.has_wings,
                    claw=p.has_claw, taken=sorted(s.taken), dead=sorted(list(d) for d in s.dead if d in BOSS_IDS),
                    bought=s.bought, nail=s.nail_lvl, focus=s.focus_lvl, soul=s.soul_lvl,
                    visited=sorted(s.visited), shade=s.shade, charms=sorted(s.charms_owned),
                    equipped=list(s.equipped), notches=s.notches, playtime=s.playtime)
        try:
            with open(SAVE_FILES[s.slot], "w") as fh: json.dump(data, fh)
        except OSError:
            s.say("Could not write save file.", 3)

    def apply_save(s):
        try:
            with open(SAVE_FILES[s.slot]) as fh: d = json.load(fh)
        except (OSError, ValueError):
            return
        p = s.p
        s.spawn = tuple(d.get("spawn", s.spawn)); p.geo = d.get("geo", 0); p.maxhp = d.get("maxhp", 5)
        p.has_dash, p.has_wings, p.has_claw = d.get("dash", False), d.get("wings", False), d.get("claw", False)
        s.taken = set(d.get("taken", [])); s.dead = {tuple(x) for x in d.get("dead", [])}
        s.bought = d.get("bought", {}); s.nail_lvl = d.get("nail", 0)
        s.focus_lvl = d.get("focus", 0); s.soul_lvl = d.get("soul", 0)
        s.visited = set(d.get("visited", [])); s.shade = d.get("shade")
        s.charms_owned = set(d.get("charms", [])); s.equipped = list(d.get("equipped", []))
        s.notches = d.get("notches", 4); s.playtime = d.get("playtime", 0.0)

    def build_solids(s):
        base, gt = ROOMS[s.ri], set()
        for gx, gy, gw, gh, bid in base["gates"]:
            if bid not in s.dead:
                gt |= {(x, y) for x in range(gx, gx + gw) for y in range(gy, gy + gh)}
        s.room["solid"] = base["solid"] | gt
        s.room["gate"] = gt

    def interact(s):
        p = s.p
        for n in s.room["npcs"]:
            if p.rect.colliderect(npc_rect(n)):
                s.talk = dict(npc=n, i=0, shop=False); s.state = "talk"; return
        for d in s.room["doors"]:
            if p.rect.colliderect(door_rect(d)):
                s.load_room(d["to"])
                p.x, p.y = d["tx"] * T + 4, (d["ty"] + 1) * T - p.h
                p.vx = p.vy = 0; p.safe = (p.x, p.y); return
        for bx, by in s.room["benches"]:
            if p.rect.colliderect(pygame.Rect(bx * T - 8, by * T, 48, T)):
                s.rest(); return

    def talk_update(s, pressed):
        tk = s.talk; n = tk["npc"]
        s.note_t = max(0, s.note_t - 0.016)
        adv = pressed & {pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE, pygame.K_z,
                         pygame.K_x, pygame.K_w, pygame.K_UP}
        if tk["shop"]:
            for i, (lbl, cost, key, lim) in enumerate(n["shop"]):
                if pygame.K_1 + i in pressed: s.buy(key, cost, lim, lbl)
            if pressed & {pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_SPACE}: s.state = "play"
        elif adv:
            if tk["i"] < len(n["lines"]) - 1: tk["i"] += 1
            elif n.get("shop"): tk["shop"] = True
            else: s.state = "play"

    def buy(s, key, cost, lim, label):
        p, n = s.p, s.bought.get(key, 0)
        if n >= lim: s.say("Sold out.", 2); return
        price = cost * (n + 1)
        if p.geo < price: s.say("Not enough Geo.", 2); return
        p.geo -= price; s.bought[key] = n + 1
        if key == "mask": p.maxhp += 1; p.hp = p.maxhp
        elif key == "nail": s.nail_lvl += 1
        elif key == "focus": s.focus_lvl = 1
        elif key == "soul": s.soul_lvl += 1
        elif key.startswith("charm:"): s.charms_owned.add(key[6:])
        s.say("Purchased: " + label, 2.5)

    def respawn(s):
        p, (ri, bx, by) = s.p, s.spawn
        s.load_room(ri)
        p.x, p.y = bx * T + 4, (by + 1) * T - p.h
        p.vx = p.vy = 0
        p.hp, p.soul, p.iframes, p.slash, p.focus = p.maxhp, 0, 1.0, None, 0
        p.safe = (p.x, p.y)

    def rest(s):
        p = s.p
        p.hp = p.maxhp
        s.spawn = (s.ri, int(p.x // T), 14)
        s.dead = {d for d in s.dead if d in BOSS_IDS}
        s.load_room(s.ri)
        s.save(); s.say("Rested. Progress saved.", 2.5)

    def hurt(s, dmg, srcx):
        p = s.p
        if s.mods.get("god", False) or p.iframes > 0 or s.state != "play": return
        p.hp -= max(1, dmg + DIFF[SETTINGS["diff"]][1])
        s.play_sfx("hurt", 0.9)
        p.iframes, p.knock, p.focus, p.dashing, p.slash = (2.0 if s.eq("stone_skin") else 1.3) * DIFF[SETTINGS["diff"]][2], 0.25, 0, 0, None
        p.vx = (1 if p.x + 12 > srcx else -1) * 320
        p.vy = -320
        s.shake = 0.2
        if p.hp <= 0:
            if p.geo > 0:
                s.shade = dict(room=s.ri, x=p.x, y=p.y, geo=p.geo)
            p.geo = 0
            s.state, s.timer = "dead", 2.0

    def hazard(s):
        s.hurt(1, s.p.x)
        if s.state == "play":
            s.p.x, s.p.y = s.p.safe
            s.p.vx = s.p.vy = 0

    def pogo(s):
        p = s.p
        p.vy, p.jumping, p.air_dash, p.dashing = -560, False, True, 0
        s.play_sfx("pogo", 0.8)
        p.air_jumps = 1

    def slash_rect(s):
        p = s.p; r = p.rect; d = p.slash["dir"]
        ex = 16 if s.eq("long_nail") else 0
        if d == "up": return pygame.Rect(r.centerx - 24, r.top - 52 - ex, 48, 56 + ex)
        if d == "down": return pygame.Rect(r.centerx - 24, r.bottom - 4, 48, 56 + ex)
        if p.face > 0: return pygame.Rect(r.right - 4, r.centery - 24, 60 + ex, 48)
        return pygame.Rect(r.left - 56 - ex, r.centery - 24, 60 + ex, 48)

    def hit_enemy(s, e, sl):
        p = s.p
        sl["hit"].add(id(e))
        damage = 5 + 3 * s.nail_lvl + (3 if s.eq("heavy_nail") else 0)
        if s.mods.get("one_hit", False) and e.kind not in BOSSES: damage = e.hp
        e.hp -= damage; e.flash = 0.12
        s.play_sfx("hit", 0.85)
        p.soul = min(99, p.soul + 11 + 4 * s.soul_lvl + (6 if s.eq("soul_catch") else 0))
        if e.kind not in HEAVY:
            e.stun = 0.2
            e.vx = p.face * 220 if sl["dir"] in ("l", "r") else 0
            if e.kind == "crawl": e.vy = -150
        if sl["dir"] == "down": s.pogo()
        if e.hp <= 0:
            s.en.remove(e); s.dead.add(e.id); p.geo += int(e.geo * (1.5 if s.eq("greed") else 1))
            if e.kind in BOSSES:
                s.say(BOSS_MSG[e.kind] + "  (+1 charm notch)", 4); s.build_solids(); s.notches = min(11, s.notches + 1)
                if e.id == FINAL_ID: s.timer, s.flash_t = 2.5, 2.5

    # ---- per-frame
    def update(s, dt, pressed):
        p, K = s.p, pygame
        s.apply_mods()
        k = pygame.key.get_pressed()
        L, R = k[K.K_a] or k[K.K_LEFT], k[K.K_d] or k[K.K_RIGHT]
        U, D = k[K.K_w] or k[K.K_UP], k[K.K_s] or k[K.K_DOWN]
        jump_held = k[K.K_SPACE] or k[K.K_z]
        dirx = int(bool(R)) - int(bool(L))
        for a in ("iframes", "knock", "dash_cd", "atk_cd", "dashing", "wj"):
            setattr(p, a, max(0, getattr(p, a) - dt))
        s.shake = max(0, s.shake - dt); s.note_t = max(0, s.note_t - dt); s.area_t = max(0, s.area_t - dt); s.flash_t = max(0, s.flash_t - dt); s.playtime += dt

        if pressed & {K.K_SPACE, K.K_z}: p.buf = 0.12
        p.buf -= dt
        p.coyote = 0.1 if p.ground else p.coyote - dt

        if pressed & {K.K_f}:
            if p.hp >= p.maxhp: s.say("Health is full.", 1.5)
            elif p.soul < 33: s.say("Need 33 Soul to Focus. Hit enemies to gain Soul.", 2.5)
        # Focus (hold F to convert Soul into a mask)
        if (k[K.K_f] and p.ground and p.soul >= 33 and p.hp < p.maxhp
                and not dirx and p.knock <= 0 and p.dashing <= 0):
            if p.focus <= 0:
                s.play_sfx("focus", 0.7)
            p.focus += dt; p.vx = 0
            if p.focus >= s.focus_time():
                p.hp += 1; p.soul -= 33; p.focus = 0
                s.play_sfx("heal", 0.75)
        else:
            p.focus = 0

        if p.focus == 0 and p.knock <= 0:
            if (pressed & {K.K_c, K.K_LSHIFT, K.K_l} and p.has_dash and p.dash_cd <= 0
                    and (p.ground or p.air_dash)):
                p.dashing, p.dash_cd = (0.26, 0.3) if s.eq("swift_dash") else (0.2, 0.6)
                s.play_sfx("dash", 0.75)
                if not p.ground: p.air_dash = False
            if p.dashing > 0:
                p.vx, p.vy = p.face * 820, 0
            else:
                if p.wj <= 0:
                    p.vx = dirx * ((680 if s.mods.get("super_speed", False) else (340 if s.eq("wind_stride") else 290)))
                    if dirx: p.face = dirx
                cling = p.has_claw and not p.ground and p.wall != 0 and dirx == p.wall
                if cling and p.vy > 90: p.vy = 90
                if p.buf > 0 and p.coyote > 0:
                    p.vy, p.buf, p.coyote, p.jumping = (-(1100 if s.mods.get("super_jump", False) else 720)), 0, 0, True
                    s.play_sfx("jump", 0.8)
                elif p.buf > 0 and cling:
                    p.vy, p.vx, p.buf, p.jumping, p.wj = -690, -p.wall * 280, 0, True, 0.16
                    s.play_sfx("jump", 0.72)
                    p.face = -p.wall; p.air_dash = True; p.air_jumps = 1
                elif p.buf > 0 and p.has_wings and p.air_jumps > 0 and not p.ground:
                    p.vy, p.buf, p.jumping = -690, 0, True
                    s.play_sfx("jump", 0.72)
                    p.air_jumps -= 1
                if p.jumping and not jump_held and p.vy < -200:
                    p.vy, p.jumping = -200, False
                if p.vy >= 0: p.jumping = False
            if pressed & {K.K_x, K.K_j} and p.atk_cd <= 0:
                d = "up" if U else "down" if (D and not p.ground) else ("r" if p.face > 0 else "l")
                p.slash, p.atk_cd = dict(dir=d, t=0.16, hit=set()), (0.22 if s.eq("quick_slash") else 0.35)
                s.play_sfx("slash_heavy" if s.eq("heavy_nail") else "slash", 0.9)

        if not p.ground and abs(p.vy) < 140 and jump_held and p.dashing <= 0:
            p.vy -= GRAV * dt * 0.45
        pre_vy, was_g = p.vy, p.ground
        p.move(s.room, dt, p.dashing <= 0)
        if p.ground and not was_g and pre_vy > 150:
            p.land_t, p.land_amt = 0.18, max(0.35, min(1.0, pre_vy / 650))
        if was_g and not p.ground and p.vy < 0:
            p.jump_t = 0.2
        p.land_t = max(0, p.land_t - dt); p.jump_t = max(0, p.jump_t - dt)
        if p.ground and abs(p.vx) > 20:
            p.walk_t += dt * 13
            # Play exactly one footstep at each leg cycle, rather than every frame.
            step_cycle = int(p.walk_t / math.pi)
            if step_cycle != p.last_step_cycle:
                p.last_step_cycle = step_cycle
                s.play_sfx("step", 0.52)
        update_cape(p, dt, pygame.time.get_ticks() / 1000)
        if p.ground:
            p.air_dash = True; p.air_jumps = 1
            p.safe = (p.x, p.y)

        # nail slash
        if p.slash:
            sl = p.slash; sl["t"] -= dt
            r = s.slash_rect()
            for e in list(s.en):
                if id(e) not in sl["hit"] and r.colliderect(e.rect): s.hit_enemy(e, sl)
                elif e.kind == "seraph" and id(e) not in sl["hit"] and e.state == "fight":
                    for hd in e.hands:
                        if hd["state"] == "rest" and r.colliderect(pygame.Rect(int(hd["x"]) - 75, int(hd["y"]), 150, 170)):
                            s.hit_enemy(e, sl); break
            if sl["dir"] == "down" and "pogo" not in sl:
                for cx, cy in s.room["spikes"]:
                    if r.colliderect(pygame.Rect(cx * T, cy * T, T, T)):
                        sl["pogo"] = True; s.pogo(); break
            sh = s.shade
            if sh and sh["room"] == s.ri and "shade" not in sl and \
                    r.colliderect(pygame.Rect(sh["x"], sh["y"], 24, 44)):
                p.geo += sh["geo"]; s.shade = None; sl["shade"] = True
                s.say("Your Geo returns to you.", 2.5)
            if sl["t"] <= 0: p.slash = None

        # enemies, shots, hazards
        for e in s.en:
            e.update(s, dt)
            if p.rect.colliderect(e.rect.inflate(-6, -6)): s.hurt(e.dmg, e.x + e.w / 2)
        for sh in list(s.shots):
            if sh[5] == "spit": sh[4] += 700 * dt
            sh[0] += sh[2] * dt; sh[1] += sh[4] * dt; sh[3] -= dt
            if sh[5] == "wave": r = pygame.Rect(int(sh[0]) - 15, int(sh[1]), 30, 22)
            else: r = pygame.Rect(int(sh[0]) - 8, int(sh[1]) - 8, 16, 16)
            if sh[3] <= 0 or solids(s.room, r.inflate(-6, -6)): s.shots.remove(sh)
            elif p.rect.colliderect(r):
                s.hurt(1, sh[0])
                if sh[5] != "wave": s.shots.remove(sh)
        for cx, cy in s.room["spikes"]:
            if p.rect.colliderect(pygame.Rect(cx * T + 4, cy * T + T // 2, T - 8, T // 2)):
                s.hazard(); break
        if p.y > H + 64: s.hazard()

        # items & benches
        for name, ix, iy in s.room["items"]:
            if name not in s.taken and p.rect.colliderect(pygame.Rect(ix * T, iy * T, T, T)):
                s.taken.add(name); kd = name.split(":")[0].rstrip("0123456789")
                if kd == "charm":
                    ck = name.split(":")[1]; s.charms_owned.add(ck)
                    s.say("Charm found: " + CHARMS[ck]["name"] + "!  Press I to equip it.", 6)
                    continue
                if kd == "cloak": p.has_dash = True
                elif kd == "wings": p.has_wings = True
                elif kd == "claw": p.has_claw = True
                elif kd == "mask": p.maxhp += 1; p.hp = p.maxhp
                elif kd == "geocache": p.geo += 150
                s.say(ITEM_MSG[kd], 6)
        if pressed & {K.K_w, K.K_UP}: s.interact()

        # room transitions
        cx = p.x + p.w / 2
        if cx < 0 and (s.ri, "L") in LINKS:
            s.load_room(LINKS[(s.ri, "L")]); p.x = s.room["w"] * T - 40
        elif cx > s.room["w"] * T and (s.ri, "R") in LINKS:
            s.load_room(LINKS[(s.ri, "R")]); p.x = 8
        s.cam = max(0, min(p.rect.centerx - W // 2, s.room["w"] * T - W))

        if FINAL_ID in s.dead and s.timer > 0:
            s.timer -= dt
            if s.timer <= 0:
                s.stop_music()
                s.state = "win"

    # ---- drawing
    def draw(s):
        scr, A = s.scr, s.art
        t = pygame.time.get_ticks() / 1000
        scr.blit(A["bg"], (0, 0))
        if s.state == "title":
            s.draw_menu(); return
        shx = random.randint(-4, 4) if s.shake > 0 and SETTINGS["shake"] else 0
        cam, p = int(s.cam), s.p
        ox = -cam + shx
        for key, fac in (("far", 0.2), ("near", 0.45)):
            lw = A[key].get_width()
            x0 = -int(cam * fac) % lw - lw
            scr.blit(A[key], (x0, 0)); scr.blit(A[key], (x0 + lw, 0))
        for x0, y0, ph, sp in A["spores"]:
            sx = (x0 + t * 8 * sp - cam * 0.6) % W
            sy = (y0 + math.sin(t * sp + ph) * 15 - t * 4 * sp) % H
