def gen_room(rng, rname, ri, k, pool, tint, gid):
    w = rng.randint(60, 100)
    kind = rng.choice(("hops", "pits", "gauntlet", "pillars"))
    plats, pits, spikes, blocks = [], [], [], []
    x = 12
    if kind == "hops":
        row = 12
        while x < w - 14:
            n = rng.randint(3, 6); plats.append((x, row, n)); x += n + rng.randint(2, 4)
            row = max(5, min(12, row + rng.choice((-2, -1, 0, 1, 2))))
    elif kind == "pits":
        while x < w - 20:
            pw = rng.randint(4, 7); pits.append((x, x + pw - 1))
            if pw >= 6 and rng.random() < 0.6: plats.append((x + pw // 2 - 1, 12, 2))
            x += pw + rng.randint(7, 11)
    elif kind == "gauntlet":
        while x < w - 16:
            sw = rng.randint(2, 3); spikes += [(x + i, 14) for i in range(sw)]
            x += sw + rng.randint(6, 10)
    else:
        while x < w - 14:
            h = rng.randint(2, 5); blocks.append((x, 15 - h, 2, h)); x += 2 + rng.randint(6, 10)
    bad = set()
    for a, b in pits: bad |= set(range(a - 1, b + 2))
    for bx, by, bw, bh in blocks: bad |= set(range(bx - 1, bx + bw + 1))
    for sx, sy in spikes: bad |= {sx - 1, sx, sx + 1}
    cols = [c for c in range(9, w - 9) if c not in bad]
    spawns = []
    for _ in range(w // 10 + ri + (3 if kind == "gauntlet" else 0)):
        kd, c = rng.choice(pool), rng.choice(cols)
        if kd in ("fly", "ghost"): spawns.append((kd, c, rng.randint(2, 4)))
        elif kd == "bat": spawns.append((kd, c, 1))
        else: spawns.append((kd, c, 14))
    npcs = []
    if k % 5 == 2:
        npcs.append(npc(rng.choice(NPC_NAMES), rng.choice(("elder", "hunter", "child", "hermit")), w - 7, 14,
                        [rng.choice(LORE), rng.choice(LORE)]))
    if k % 7 == 4:
        npcs.append(npc("Wandering Trader", "merchant", 7, 14, ["Rare wares from the deep. Take a look."],
                        shop=[("Mask Shard", 100, "mask", 2), ("Nail Sharpening", 150, "nail", 3)]))
    items = []
    if rng.random() < 0.3: items.append(("geocache%d" % gid, rng.choice(cols), 14))
    if k % 9 == 6: items.append(("mask%d" % gid, rng.choice(cols), 14))
    if k in (5, 9) and GEN_CHARMS: items.append(("charm:" + GEN_CHARMS.pop(), rng.choice(cols), 14))
    room = mkroom("%s %d" % (rname, k + 1), w, plats=plats, pits=pits, spikes=spikes, blocks=blocks,
                  benches=[(4, 14)] if k % 3 == 0 else [], spawns=spawns, items=items, npcs=npcs)
    room["tint"] = tint
    return room


def gen_boss_room(rname, tint, bkind, gid, is_last):
    spawn = {"boss": ("boss", 22, 12), "weaver": ("weaver", 18, 5), "warden": ("warden", 26, 14)}[bkind]
    room = mkroom(rname + " Guardian", 38, plats=[(6, 11, 4), (28, 11, 4)], right=not is_last,
                  benches=[(3, 14)], gates=[] if is_last else [(37, 11, 1, 4, (gid, 0))], spawns=[spawn])
    room["tint"] = tint
    return room


def gen_world(seed=1234):
    rng = random.Random(seed)
    prev, final = 12, None
    GEN_CHARMS[:] = sorted(c for c in CHARMS if c not in ("greed", "quick_slash")); rng.shuffle(GEN_CHARMS)
    for ri, (rname, tint, pool, bkind, count) in enumerate(REGIONS):
        for k in range(count):
            gid = len(ROOMS)
            ROOM_DEPTH[gid] = ri + 1
            last = k == count - 1
            ROOMS.append(gen_boss_room(rname, tint, bkind, gid, ri == len(REGIONS) - 1) if last
                         else gen_room(rng, rname, ri, k, pool, tint, gid))
            MAP_POS.append((k, 3 + ri))
            LINKS[(prev, "R")] = gid; LINKS[(gid, "L")] = prev; prev = gid
            if last: final = (gid, 0)
    return final


