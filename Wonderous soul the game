def build_props(room, ri):
    rng = random.Random(100 + ri)
    out = []
    for cx, cy in sorted(room["solid"]):
        if cy > 0 and (cx, cy - 1) not in room["solid"] and rng.random() < 0.4:
            out.append((rng.choice(("mush", "crys", "grass", "rock")),
                        cx * T + rng.randint(4, 24), cy * T, rng.random()))
