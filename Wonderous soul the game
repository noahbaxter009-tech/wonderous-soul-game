def solids(room, r):
    out = []
    for cx in range(r.left // T, (r.right - 1) // T + 1):
        for cy in range(r.top // T, (r.bottom - 1) // T + 1):
            if (cx, cy) in room["solid"]:
                out.append(pygame.Rect(cx * T, cy * T, T, T))
    return out


class Body:
    def __init__(s, x, y, w, h):
        s.x, s.y, s.w, s.h = x, y, w, h
        s.vx = s.vy = 0
        s.ground, s.wall = False, 0

    @property
    def rect(s):
        return pygame.Rect(int(s.x), int(s.y), s.w, s.h)

    def move(s, room, dt, grav=True):
        if grav: s.vy = min(s.vy + GRAV * dt, MAXFALL)
        s.wall, s.ground = 0, False
        s.x += s.vx * dt
        r, hit = s.rect, False
        for t in solids(room, r):
            hit = True
            if s.vx > 0: r.right = t.left; s.wall = 1
            elif s.vx < 0: r.left = t.right; s.wall = -1
        if hit: s.x = r.x
        vy0 = s.vy
        s.y += s.vy * dt
        r, hit = s.rect, False
        for t in solids(room, r):
            hit = True
            if vy0 > 0: r.bottom = t.top; s.ground = True
            elif vy0 < 0: r.top = t.bottom
        if hit: s.y = r.y; s.vy = 0
        if not s.ground and s.vy >= 0 and solids(room, s.rect.move(0, 1)):
            s.ground = True; s.vy = 0


