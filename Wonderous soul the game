def wrap(font, text, width):
    lines, cur = [], ""
    for w_ in text.split():
        test = (cur + " " + w_).strip()
        if font.size(test)[0] > width and cur: lines.append(cur); cur = w_
        else: cur = test
    return lines + [cur]


