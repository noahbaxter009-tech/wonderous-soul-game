            s.text("WONDEROUS SOUL", s.big, (230, 230, 245), W // 2, 150, True)
            for i, ln in enumerate(["A/D or arrows: move     Space / Z: jump (hold = higher)",
                                    "X / J: nail  (hold W = up, hold S in air = down-strike pogo)",
                                    "C / Shift: dash (find the cloak)   F (hold): Focus, heals for 33 Soul",
                                    "W / Up: rest at benches, talk to bugs, use doors.    M: map    I: charms",
