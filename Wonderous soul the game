def update_cape(p, dt, t):
    N, seg = 8, 6.0
    ax, ay = p.x + p.w / 2 - p.face * 3, p.y + 21
    if p.cape is None or math.hypot(p.cape[1][0] - ax, p.cape[1][1] - ay) > 90:
        p.cape = [[ax - p.face * i * 2, ay + i * seg * 0.9] for i in range(N)]
    c = p.cape
    c[0] = [ax, ay]
    sp = abs(p.vx) / 300
    k = min(1, 14 * dt)
    for i in range(1, N):
        px, py = c[i - 1]; x, y = c[i]
        tx = px - p.vx * 0.045 * (1 + i * 0.1) - p.face * 2 + math.sin(t * 7 + i * 0.9) * (1 + sp * 3)
        ty = py + seg * 0.9 - p.vy * 0.012 + math.sin(t * 5 + i) * 0.6
        x += (tx - x) * k; y += (ty - y) * k
        dx, dy = x - px, y - py
        d = math.hypot(dx, dy) or 1
        if d > seg: x, y = px + dx / d * seg, py + dy / d * seg
        c[i] = [x, y]


def draw_cape(scr, pts, ox, col=(150, 32, 48)):
    L, R = [], []
    n = len(pts)
    for i, (x, y) in enumerate(pts):
        nx, ny = pts[min(i + 1, n - 1)]; px, py = pts[max(i - 1, 0)]
        dx, dy = nx - px, ny - py
        d = math.hypot(dx, dy) or 1
        w = 3 + i * 1.7
        L.append((x + ox - dy / d * w, y + dx / d * w))
        R.append((x + ox + dy / d * w, y - dx / d * w))
    poly = L + R[::-1]
    pygame.draw.polygon(scr, col, poly)
    pygame.draw.lines(scr, shade(col, 45), False, [(x + ox, y) for x, y in pts[1:]], 2)
    pygame.draw.polygon(scr, shade(col, -40), poly, 2)


def ik(hip, foot, l1, l2, bend):
    dx, dy = foot[0] - hip[0], foot[1] - hip[1]
    dist = math.hypot(dx, dy) or 1
    d = min(dist, l1 + l2 - 0.5)
    a = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
    h = math.sqrt(max(0, l1 * l1 - a * a))
    ux, uy = dx / dist, dy / dist
    return (hip[0] + ux * a - uy * h * bend, hip[1] + uy * a + ux * h * bend)


def draw_player(scr, p, ox, t):
    R = p.rect.move(ox, 0)
    f = p.face
    if p.has_wings and not p.ground:
        fw = math.sin(t * 20) * 6
        for s_ in (-1, 1):
            pygame.draw.polygon(scr, (255, 245, 190), [(R.centerx + s_ * 3, R.y + 24), (R.centerx + s_ * 24, R.y + 10 + fw),
                                                       (R.centerx + s_ * 18, R.y + 30)])
    if p.cape: draw_cape(scr, p.cape, ox)

    sf = pygame.Surface((110, 120), pygame.SRCALPHA)
    r = pygame.Rect(43, 44, p.w, p.h)
    cx = r.centerx
    moving = p.ground and abs(p.vx) > 20 and p.knock <= 0
    spd = min(1.0, abs(p.vx) / 290)
    bob = -abs(math.sin(p.walk_t)) * 3 * spd if moving else math.sin(t * 2.2)
    lean = max(-1, min(1, p.vx / 290)) * 3 if p.knock <= 0 else 0
    cloth, cloth2 = (34, 34, 54), (54, 54, 80)
    hipy = r.y + 29 + bob * 0.5
    gy = r.bottom - 3
    rise = max(0, min(1, -p.vy / 600)); fall = max(0, min(1, p.vy / 600))

    def leg(side, ph):
        hx = cx + side * 4 + lean * 0.3
        hip = (hx, hipy)
        if p.dashing > 0:
            foot = (hx - f * 13, gy - 8 + side * 2)
        elif not p.ground:
            front = side > 0
            foot = (hx + f * rise * (8 if front else -4) + side * fall * 3,
                    gy - rise * (9 if front else 5) + fall * 2)
        elif moving:
            a = math.sin(p.walk_t + ph)
            lift = max(0, math.cos(p.walk_t + ph)) * 7 * (0.5 + 0.5 * spd)
            foot = (hx + f * a * 10 * (0.5 + 0.5 * spd), gy - lift)
        else:
            foot = (hx + f, gy)
        knee = ik(hip, foot, 8, 8, -f)
        col = (176, 180, 208) if side > 0 else (118, 122, 156)
        for wd, c in ((8, (18, 18, 32)), (5, col)):
            pygame.draw.line(sf, c, hip, knee, wd)
            pygame.draw.line(sf, c, knee, foot, wd - 1)
            pygame.draw.circle(sf, c, (int(knee[0]), int(knee[1])), wd // 2)
        pygame.draw.ellipse(sf, (18, 18, 32), (foot[0] - 6 + f * 3, foot[1] - 3, 14, 9))
        pygame.draw.ellipse(sf, col, (foot[0] - 5 + f * 3, foot[1] - 2, 12, 6))

    leg(-1, 0.0)
    ty = r.y + 17 + bob
    tx = cx + lean * 0.5
    pygame.draw.ellipse(sf, cloth, (tx - 9, ty, 18, 15))
    pygame.draw.ellipse(sf, cloth2, (tx - 6 + f, ty + 3, 9, 8))
    leg(1, math.pi)
    hx0, hy = cx + lean, r.y + bob - 1
    for s_ in (-1, 1):
        bx = hx0 + s_ * 7
        pygame.draw.polygon(sf, (238, 238, 246), [(bx - 3, hy + 9), (bx + 3, hy + 9),
                            (bx + s_ * 8, hy + 1), (bx + s_ * 9, hy - 8), (bx + s_ * 4, hy - 1)])
    pygame.draw.ellipse(sf, (226, 226, 238), (hx0 - 12, hy + 2, 24, 22))
    pygame.draw.ellipse(sf, (248, 248, 254), (hx0 - 9 + f * 2, hy + 4, 14, 8))
    pygame.draw.ellipse(sf, (190, 190, 210), (hx0 - 12, hy + 2, 24, 22), 2)
    for s_ in (-1, 1):
        pygame.draw.ellipse(sf, (12, 12, 20), (hx0 + s_ * 5 + f * 2 - 3, hy + 11, 6, 8))
    hand = (tx + f * 7, ty + 9)
    if p.slash:
        v = {"up": (0, -1), "down": (0, 1), "l": (-1, 0), "r": (1, 0)}[p.slash["dir"]]
    else:
        v = (-f * 0.4, 0.9)
    tip = (hand[0] + v[0] * 24, hand[1] + v[1] * 24)
    pygame.draw.line(sf, cloth2, (tx + f * 3, ty + 5), hand, 3)
    pygame.draw.line(sf, (222, 226, 238), hand, tip, 3)
    pygame.draw.line(sf, (120, 110, 100), (hand[0] - v[0] * 3, hand[1] - v[1] * 3), hand, 4)

    sx = sy = 1.0
    if p.land_t > 0:
        k = p.land_t / 0.18 * p.land_amt
        sy, sx = 1 - 0.24 * k, 1 + 0.20 * k
    elif not p.ground:
        k = min(1.0, abs(p.vy) / 700)
        sy, sx = 1 + 0.15 * k, 1 - 0.09 * k
    if p.jump_t > 0:
        sy += 0.12 * p.jump_t / 0.2; sx -= 0.08 * p.jump_t / 0.2
    if abs(sx - 1) > 0.01 or abs(sy - 1) > 0.01:
        sf = pygame.transform.smoothscale(sf, (int(110 * sx), int(120 * sy)))
    scr.blit(sf, (R.centerx - int(cx * sx), R.bottom - int(r.bottom * sy)))


