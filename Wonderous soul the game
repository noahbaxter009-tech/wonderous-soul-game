def mkroom(name, w, plats=(), pits=(), spikes=(), left=True, right=True, benches=(), spawns=(),
           items=(), blocks=(), gates=(), npcs=(), doors=()):
    solid, sp = set(), set(spikes)
    for x in range(w):
        solid.add((x, 0))
        for y in (15, 16):
            if any(a <= x <= b for a, b in pits):
                if y == 16:
                    sp.add((x, 16))
            else:
                solid.add((x, y))
    for y in range(17):
        if not (left and 11 <= y <= 14): solid.add((0, y))
        if not (right and 11 <= y <= 14): solid.add((w - 1, y))
    for x, y, n in plats:
        for i in range(n): solid.add((x + i, y))
    for bx, by, bw, bh in blocks:
        for i in range(bw):
            for j in range(bh): solid.add((bx + i, by + j))
    return dict(name=name, w=w, solid=solid, spikes=sp, benches=list(benches), spawns=list(spawns),
                items=list(items), gates=list(gates), npcs=list(npcs), doors=list(doors))


