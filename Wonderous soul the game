            pygame.draw.circle(scr, c, (34 + i * 30, 30), 11, 0 if i < p.hp else 2)
        pygame.draw.circle(scr, (60, 70, 100), (34, 84), 22, 2)
        scr.set_clip(pygame.Rect(0, 62 + int(44 * (1 - p.soul / 99)), W, 44))
        pygame.draw.circle(scr, (190, 220, 255) if p.soul >= 33 else (110, 140, 190), (34, 84), 20)
        scr.set_clip(None)
        pygame.draw.circle(scr, (240, 200, 90), (78, 84), 8)
        s.text(str(p.geo), s.font, (240, 220, 150), 94, 74)
        b = next((e for e in s.en if e.kind in BOSSES), None)
