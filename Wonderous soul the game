def cl(v): return max(0, min(255, int(v)))
def shade(c, d): return tuple(cl(v + d) for v in c[:3])

GLOW = {}
def glow(radius, color):
    k = (radius, color)
    if k not in GLOW:
        sf = pygame.Surface((radius * 2, radius * 2), pygame.SRCALPHA)
        for r in range(radius, 0, -2):
            pygame.draw.circle(sf, (*color, int(110 * (1 - r / radius) ** 2)), (radius, radius), r)
        GLOW[k] = sf
    return GLOW[k]


def make_stone(rng):
    base = (46 + rng.randint(-5, 5), 50 + rng.randint(-5, 5), 76 + rng.randint(-5, 5))
    sf = pygame.Surface((T, T)); sf.fill(base)
    for _ in range(12):
        pygame.draw.circle(sf, shade(base, rng.randint(-14, 12)),
                           (rng.randrange(T), rng.randrange(T)), rng.randint(2, 6))
    for _ in range(70):
        sf.set_at((rng.randrange(T), rng.randrange(T)), shade(base, rng.randint(-26, 26)))
    if rng.random() < 0.6:
        x, y = rng.randrange(6, 26), rng.randrange(2, 8)
        for _ in range(5):
            nx, ny = x + rng.randint(-6, 6), y + rng.randint(3, 7)
            pygame.draw.line(sf, shade(base, -32), (x, y), (nx, ny), 1); x, y = nx, ny
    for a, b in (((0, 0), (T - 1, 0)), ((0, 0), (0, T - 1))):
        pygame.draw.line(sf, shade(base, 14), a, b)
    for a, b in (((0, T - 1), (T - 1, T - 1)), ((T - 1, 0), (T - 1, T - 1))):
        pygame.draw.line(sf, shade(base, -22), a, b)
    return sf


def make_top(stone, rng):
    sf = pygame.Surface((T, T + 8), pygame.SRCALPHA)
    sf.blit(stone, (0, 8))
    for x in range(T):
        c = (rng.randint(40, 70), rng.randint(95, 150), rng.randint(70, 100))
        pygame.draw.line(sf, c, (x, 8 - rng.randint(0, 6)), (x, 8 + rng.randint(3, 7)))
    for x in range(2, T, 5):
        pygame.draw.line(sf, (48, 110, 80), (x, 12), (x + rng.randint(-1, 1), 12 + rng.randint(4, 9)))
    return sf


def make_layer(rng, color, lw, hmin, hmax):
    sf = pygame.Surface((lw, H), pygame.SRCALPHA)
    x = 0
    while x < lw:
        wd, h = rng.randint(30, 90), rng.randint(hmin, hmax)
        pygame.draw.polygon(sf, color, [(x, 0), (x + wd, 0), (x + wd * 0.55 + rng.randint(-8, 8), h)])
        wd, h = rng.randint(30, 90), rng.randint(hmin, hmax)
        pygame.draw.polygon(sf, color, [(x, H), (x + wd, H), (x + wd * 0.45 + rng.randint(-8, 8), H - h)])
        x += rng.randint(50, 110)
    return sf


def make_art():
    rng = random.Random(7)
